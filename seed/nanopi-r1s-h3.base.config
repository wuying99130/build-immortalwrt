# 目标平台与机型
CONFIG_TARGET_sunxi=y
CONFIG_TARGET_sunxi_cortexa7=y
CONFIG_TARGET_sunxi_cortexa7_DEVICE_friendlyarm_nanopi-r1s-h3=y

# 主机名（后续可用于 nanopi.local 登录）
CONFIG_OPENWRT_HOSTNAME="nanopi-r1s-h3"

# LuCI 中文界面（最小化）
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# Web 服务器与 RPC
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y

# 基础系统工具
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_libiwinfo=y
CONFIG_PACKAGE_libiwinfo-data=y
CONFIG_PACKAGE_cgi-io=y

# 网络协议支持
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_ipv6helper=y

# 以太网、PHY、USB 网卡（千兆 + 百兆）
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-uhci=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y   # USB 网卡（第二个网口）
CONFIG_PACKAGE_kmod-phy-sun4i-usb=y     # H3 USB PHY
CONFIG_PACKAGE_kmod-sunxi-gmac=y        # H3 内置 GMAC（千兆）
CONFIG_PACKAGE_kmod-mdio=y
CONFIG_PACKAGE_kmod-libphy=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y

# SDIO WiFi（AP6212 / BCM43430）
CONFIG_PACKAGE_kmod-brcmfmac=y
CONFIG_BRCMFMAC_SDIO=y
CONFIG_PACKAGE_brcmfmac-firmware-43430-sdio=y

# WiFi 管理与加密
CONFIG_PACKAGE_wireless-tools=y
CONFIG_PACKAGE_hostapd-common=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y

# MMC / TF 卡（SDC0）
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_kmod-mmc-sunxi=y
CONFIG_PACKAGE_kmod-sdhci=y

# GPIO / LED / 按键 / 电源控制
CONFIG_PACKAGE_kmod-leds-gpio=y
CONFIG_PACKAGE_kmod-input-gpio-keys=y
CONFIG_PACKAGE_kmod-regulator=y
CONFIG_PACKAGE_kmod-regulator-fixed=y
CONFIG_PACKAGE_kmod-rfkill=y
CONFIG_PACKAGE_kmod-rfkill-gpio=y
CONFIG_PACKAGE_rfkill=y

# 默认设置（后续可覆盖）
CONFIG_PACKAGE_default-settings=y

# 根分区大小（TF 卡场景）
CONFIG_TARGET_ROOTFS_PARTSIZE=380

